{
  "name": "sumpath-android",
  "version": "1.7.7",
  "private": true,
  "description": "Sum Path (NC Tool List) Android",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "cap:sync": "cap sync android",
    "apk:debug": "npm run build && cap sync android && cd android && gradlew assembleDebug",
    "bump": "node tools/bump_version.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "pdfmake": "^0.2.20",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@types/node": "^22.20.5",
    "@types/pdfmake": "^0.2.13",
    "@types/three": "^0.187.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
